# Copy this file to .env.local and fill in your values.

# ── Anthropic ────────────────────────────────────────
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth (for direct Gmail API access) ───────
# See SETUP.md for the 5-min Google Cloud Console steps.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Optional override. Must EXACTLY match what you register in Google Console.
# Default works for local dev on port 3002:
# GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/google/callback
